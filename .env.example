# OpenAI API Configuration (Optional - falls back to Local Demo Mode if missing)
OPENAI_API_KEY=

# Gemini API Configuration (Optional alternative provider)
GEMINI_API_KEY=

# LLM Provider Choice: "demo", "openai", or "gemini"
LLM_PROVIDER=demo
LLM_MODEL=gpt-4o-mini

# Embedding Model Configuration
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# ChromaDB Configuration
CHROMA_DB_PATH=./chroma_db
COLLECTION_NAME=aws_technical_support

# Retrieval Settings
TOP_K=5
SIMILARITY_THRESHOLD=0.35

# Application Settings
LOG_LEVEL=INFO
