# ========================================================
# AWS Technical Support RAG Assistant - Environment Configuration
# ========================================================

# --- MySQL Database Configuration ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=aws_support_rag
DB_FALLBACK_SQLITE=true

# --- Security & Auth ---
SECRET_KEY=aws-support-rag-super-secure-key-2026
SESSION_EXPIRY_MINUTES=1440

# --- LLM Providers (Optional - falls back to Local Demo Mode if empty) ---
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_PROVIDER=demo
LLM_MODEL=gpt-4o-mini

# --- Intent Classifier Model ---
INTENT_MODEL_PATH=./models/intent_classifier.pkl
MODEL_METADATA_PATH=./models/model_metadata.json

# --- Embedding Model Configuration ---
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# --- ChromaDB Vector Store ---
CHROMA_DB_PATH=./chroma_db
COLLECTION_NAME=aws_technical_support

# --- Retrieval Hyperparameters ---
TOP_K=5
SIMILARITY_THRESHOLD=0.35

# --- Logging ---
LOG_LEVEL=INFO
